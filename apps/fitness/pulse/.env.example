# Pulse — environment template. Copy to .env and fill in real values for local dev.
# On cloud deploy (Supero upload / Cloud Run) these are INJECTED as env vars; the
# app reads them from the environment, so never commit a real .env. (SKILLS.md §10)
SUPERO_URL=https://api.supero.dev        # platform base URL
SUPERO_DOMAIN=pulse                       # your domain slug
SUPERO_PROJECT=pulse-chain                # your project slug
SUPERO_ADMIN_EMAIL=admin@pulsefitness.co
SUPERO_API_KEY=ak_...                     # from your project settings (a secret)
SUPERO_IS_MULTI_TENANT=true               # multi-tenant chain — each gym is a tenant (SKILLS.md §7.5a)
SUPERO_TENANT_NOUN_SINGULAR=location
SUPERO_TENANT_NOUN_PLURAL=locations
PORT=5648                                 # LOCAL only — cloud sets PORT itself
