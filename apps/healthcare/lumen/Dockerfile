# Safe to customize — re-running supero.cli will NOT overwrite this file if it exists.
#
# Build:   docker build -t lumen-health .
# Run:     docker run -p 5663:5663 --env-file .env lumen-health
# Or use:  docker compose up

FROM python:3.11-slim

# Security: run as non-root user
RUN useradd -m -u 1000 supero && \
    apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies first (better layer caching)
COPY --chown=supero:supero requirements.txt* ./
RUN pip install --no-cache-dir "supero==3.6.4" requests>=2.28.0 && \
    (test -f requirements.txt && pip install --no-cache-dir -r requirements.txt || true)

# Copy application files
COPY --chown=supero:supero . /app

# Ensure run.sh is executable
RUN chmod +x /app/run.sh 2>/dev/null || true

USER supero

ENV PORT=5663
ENV UI_PORT=5663
EXPOSE 5663

# Healthcheck — Supero server responds on the configured port
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:${PORT}/ || exit 1

# Run the full bootstrap + server workflow.
# Bootstrap is idempotent, so container restarts are safe.
CMD ["./run.sh", "--no-interactive"]
