# Medora — environment template. Copy to .env and fill in real values for local
# dev. On cloud deploy (Supero upload / Cloud Run) these are INJECTED as env vars;
# the app reads them from the environment, so never commit a real .env. (§10)
SUPERO_URL=https://api.supero.dev          # platform base URL
SUPERO_DOMAIN=medora                        # your domain slug
SUPERO_PROJECT=medora-network               # your project slug
SUPERO_ADMIN_EMAIL=admin@medora.health
SUPERO_API_KEY=ak_...                       # from your project settings (a secret)

# MULTI-TENANT chrome — the CLI writes these into the generated ui/config.js as
# window.__SUPERO_CONFIG.isMultiTenant / tenantNoun (read by ui/app.js for the
# TenantSwitcher + tenant labels). A hand-authored bundle MUST set them here;
# there is no AppConfig field for them. (SKILLS.md §10 gap — see config.py.)
SUPERO_IS_MULTI_TENANT=true
SUPERO_TENANT_NOUN_SINGULAR=Site
SUPERO_TENANT_NOUN_PLURAL=Sites

PORT=5648                                   # LOCAL only — cloud sets PORT itself
