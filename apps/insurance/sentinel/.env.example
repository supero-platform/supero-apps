# ── sentinel — copy to .env, then `./run.sh` ─────────────────
# cp .env.example .env

# The platform. Leave as-is unless self-hosting.
SUPERO_URL=https://api.supero.dev

# YOUR domain. Pick any free name — it becomes yours on first run.
# No account needed; registration is open.
SUPERO_DOMAIN=your-domain

# YOUR admin login for the domain above.
SUPERO_ADMIN_EMAIL=you@example.com

# REQUIRED — set a strong password. Do not leave blank.
# REQUIRED. The app refuses to start until this is set (no default).
SUPERO_PASSWORD=

# Project namespace inside your domain.
SUPERO_PROJECT=sentinel

# Filled in automatically on first run — leave blank.
SUPERO_API_KEY=

# Multi-tenant chrome — two insurers on one deployment (Northwind Mutual and
# Cascade Assurance, see config.py). These drive
# window.__SUPERO_CONFIG.isMultiTenant / tenantNoun, which ui/app.js reads for the
# tenant switcher and its labels.
#
# WHY THIS IS EXPLICIT. config.py's comment used to say the platform "infers the
# flag from the presence of business tenants". It does not. run.py reads
# SUPERO_IS_MULTI_TENANT from .env first and only falls back to the project record
# on the platform — and that record has is_multi_tenant=false with both tenant
# nouns unset. With neither source saying true, config.js shipped
# `isMultiTenant: false` and the generic noun "Workspace", so the demo presented
# itself as single-tenant while the API was demonstrably enforcing isolation
# (see verify/03-tenant-isolation.sh, which gets an HTTP 403).
SUPERO_IS_MULTI_TENANT=true
SUPERO_TENANT_NOUN_SINGULAR=Insurer
SUPERO_TENANT_NOUN_PLURAL=Insurers

PORT=5674
