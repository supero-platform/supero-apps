# .env.example  (local dev fills these; cloud deploy injects them as env vars)
SUPERO_URL=https://api.supero.dev      # platform base URL
SUPERO_DOMAIN=helix                    # your domain slug
SUPERO_PROJECT=helix-ctms              # your project slug
SUPERO_ADMIN_EMAIL=admin@helix.com
SUPERO_API_KEY=ak_...                  # from your project settings (a secret)
PORT=5648                              # LOCAL only — cloud sets PORT itself (read os.getenv("PORT"))
