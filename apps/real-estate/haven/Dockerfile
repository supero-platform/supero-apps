# Auto-generated by Supero CLI v1.2.0
# Safe to customize — re-running supero.cli will NOT overwrite this file if it exists.
#
# Build:   docker build -t haven .
# Run:     docker run -p 5675:5675 --env-file .env haven
# Or use:  docker compose up

FROM python:3.11-slim

# Security: run as non-root user
RUN useradd -m -u 1000 supero && \
    apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies first (better layer caching)
COPY --chown=supero:supero requirements.txt* ./
RUN pip install --no-cache-dir "supero==3.6.4" requests>=2.28.0 && \
    (test -f requirements.txt && pip install --no-cache-dir -r requirements.txt || true)

# Copy application files
COPY --chown=supero:supero . /app

# Ensure run.sh is executable
RUN chmod +x /app/run.sh 2>/dev/null || true

# WORKDIR created /app as root, and `COPY --chown` only chowns the entries it
# copies — not the directory itself. run.sh then creates .venv inside /app as
# uid 1000 and got `Permission denied: '/app/.venv'`, so `docker compose up`
# failed on every app. Chown the directory before dropping privileges.
RUN chown supero:supero /app

USER supero

ENV PORT=5675
ENV UI_PORT=5675
EXPOSE 5675

# Healthcheck — Supero server responds on the configured port
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:${PORT}/ || exit 1

# Run the full bootstrap + server workflow.
# Bootstrap is idempotent, so container restarts are safe.
CMD ["./run.sh", "--no-interactive"]
