# Lattice — environment template. Copy to .env and fill in real values for local dev.
# On cloud deploy (Supero upload / Cloud Run) these are INJECTED as env vars; the
# app reads them from the environment, so never commit a real .env. (SKILLS.md §10)
SUPERO_URL=https://api.supero.dev          # platform base URL
SUPERO_DOMAIN=lattice                       # your domain slug
SUPERO_PROJECT=lattice-pm                   # your project slug
SUPERO_ADMIN_EMAIL=admin@lattice.app
SUPERO_API_KEY=ak_...                       # from your project settings (a secret)

# MULTI-TENANT (this app is multi-tenant: one tenant per PM company). These env
# vars drive window.__SUPERO_CONFIG.isMultiTenant / tenantNoun (the CLI reads them
# at config.js generation — they are NOT taken from config.py). Set them so the
# TenantSwitcher + admin-vs-resident routing light up.
SUPERO_IS_MULTI_TENANT=true
SUPERO_TENANT_NOUN_SINGULAR=Company
SUPERO_TENANT_NOUN_PLURAL=Companies

PORT=5648                                   # LOCAL only — cloud sets PORT itself
